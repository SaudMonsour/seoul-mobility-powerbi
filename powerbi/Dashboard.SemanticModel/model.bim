        "measures": [
          {
            "name": "Total Rentals",
            "expression": "SUM(FactDemand[Rentals])",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Total Rentals. Format: #,0. Definition: SUM(FactDemand[Rentals]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "d8e11532-c69b-5601-acd9-55f7afb17af9"
          },
          {
            "name": "Recorded Hours",
            "expression": "COUNTROWS(FactDemand)",
            "formatString": "#,0",
            "displayFolder": "Quality and coverage",
            "description": "Recorded Hours. Format: #,0. Definition: COUNTROWS(FactDemand). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "7e0db8ee-ba1a-5389-83ce-6b5962d5d215"
          },
          {
            "name": "Operating Hours",
            "expression": "SUM(FactDemand[OperatingFlag])",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Operating Hours. Format: #,0. Definition: SUM(FactDemand[OperatingFlag]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "399f0491-3be8-59b5-817d-3125672152ac"
          },
          {
            "name": "Non-operating Hours",
            "expression": "[Recorded Hours] - [Operating Hours]",
            "formatString": "#,0",
            "displayFolder": "Quality and coverage",
            "description": "Non-operating Hours. Format: #,0. Definition: [Recorded Hours] - [Operating Hours]. See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "ef12b7d6-48d0-56f6-87a7-618fb302b696"
          },
          {
            "name": "Rentals per Operating Hour",
            "expression": "DIVIDE([Total Rentals], [Operating Hours])",
            "formatString": "#,0.0",
            "displayFolder": "Performance",
            "description": "Rentals per Operating Hour. Format: #,0.0. Definition: DIVIDE([Total Rentals], [Operating Hours]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "d1f9f442-c87d-5ae4-b952-59cd22c043d6"
          },
          {
            "name": "Peak Single Hour",
            "expression": "MAX(FactDemand[Rentals])",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Peak Single Hour. Format: #,0. Definition: MAX(FactDemand[Rentals]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "92aaa7e1-2b2c-56d1-bf12-6df6ab86349f"
          },
          {
            "name": "Average Temperature C",
            "expression": "AVERAGE(FactDemand[TemperatureC])",
            "formatString": "0.0\"°C\"",
            "displayFolder": "Performance",
            "description": "Average Temperature C. Format: 0.0\"°C\". Definition: AVERAGE(FactDemand[TemperatureC]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "872c4ad7-a3fc-5bc7-9d51-22e86ddd91e5"
          },
          {
            "name": "Rainy Operating Hours",
            "expression": "CALCULATE([Operating Hours], FactDemand[RainfallMm] > 0)",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Rainy Operating Hours. Format: #,0. Definition: CALCULATE([Operating Hours], FactDemand[RainfallMm] > 0). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "cb05703d-6bba-5f4e-a191-894e5f66309a"
          },
          {
            "name": "Rainy Operating Share",
            "expression": "DIVIDE([Rainy Operating Hours], [Operating Hours])",
            "formatString": "0.0%",
            "displayFolder": "Performance",
            "description": "Rainy Operating Share. Format: 0.0%. Definition: DIVIDE([Rainy Operating Hours], [Operating Hours]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "b62471bb-34b6-56f4-8398-fa323ceff60a"
          },
          {
            "name": "Operating Coverage",
            "expression": "DIVIDE([Operating Hours], [Recorded Hours])",
            "formatString": "0.0%",
            "displayFolder": "Quality and coverage",
            "description": "Operating Coverage. Format: 0.0%. Definition: DIVIDE([Operating Hours], [Recorded Hours]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "16681385-ebb8-5c2f-8c0a-141e9fbb2dc7"
          },
          {
            "name": "Holiday Rentals",
            "expression": "CALCULATE([Total Rentals], FactDemand[HolidayFlag] = 1)",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Holiday Rentals. Format: #,0. Definition: CALCULATE([Total Rentals], FactDemand[HolidayFlag] = 1). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "b4182998-f3b7-5381-8470-cb8407c7ed53"
          }
        ]
